# Required for `npm run build` (the build runs `formspree deploy` first).
FORMSPREE_DEPLOY_KEY=
NEXT_PUBLIC_FORMSPREE_PROJECT=

# Meta (Facebook/Instagram) Pixel. Primary ad channel.
NEXT_PUBLIC_META_PIXEL_ID=

# Google Analytics 4.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Google Ads. Both are required before lead conversions will fire.
# ID looks like AW-123456789; label is the conversion label from the Ads UI.
NEXT_PUBLIC_GOOGLE_ADS_ID=
NEXT_PUBLIC_GOOGLE_ADS_LEAD_LABEL=
